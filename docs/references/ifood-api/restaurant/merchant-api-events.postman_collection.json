      "name": "Get New Events",
      "request": {
        "name": "Get New Events",
        "description": {
          "content": "Polls events for any orders from merchants associated with the authenticated user.\n\nEach event received from this endpoint must be properly acknowledged, otherwise it will continue to be returned on further requests.[(Read more)](https://developer.ifood.com.br/docs/guides/modules/order/events)",
          "type": "text/plain"
        },
        "url": {
          "path": [
            "events:polling"
          ],
          "host": [
            "{{baseUrl}}"
          ],
          "query": [
            {
              "disabled": false,
              "key": "types",
              "value": "<string>",
              "description": "Desired event types. All other events not selected by type will be automatically acknowledged and omitted from the response. Must either be omitted or non-empty. [(Read more)](https://developer.ifood.com.br/docs/guides/modules/events/polling-overview)"
            },
            {
              "disabled": false,
              "key": "groups",
              "value": "<string>",
              "description": "Desired event groups. All other events not selected by group will be automatically acknowledged and omitted from the response. Must either be omitted or non-empty. [(Read more)](https://developer.ifood.com.br/docs/guides/modules/events/polling-overview)"
            },
            {
              "disabled": false,
              "key": "categories",
              "value": "<string>",
              "description": "Desired event categories. All other events not selected by category will be automatically acknowledged and omitted from the response. Must either be omitted or non-empty. [(Read more)](https://developer.ifood.com.br/docs/guides/modules/events/polling-overview)"
            }
          ],
          "variable": []
        },
        "header": [
          {
            "disabled": false,
            "description": "Subset of merchants to fetch events from. Must either be omitted or non-empty.",
            "key": "x-polling-merchants",
            "value": "<string>"
          },
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "method": "GET",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{bearerToken}}"
            }
          ]
        }
